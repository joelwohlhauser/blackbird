# Local Blackbird development works without an .env file.
# Optional hosted relay configuration requires services you operate.
# Do not commit credentials or enable third-party telemetry.

# Public client identifiers from your Clerk deployment:
# T3CODE_CLERK_PUBLISHABLE_KEY=
# T3CODE_CLERK_JWT_TEMPLATE=
# T3CODE_CLERK_CLI_OAUTH_CLIENT_ID=
# T3CODE_RELAY_URL=https://relay.example.com
# T3CODE_HOSTED_APP_URL=https://app.example.com

# Optional Apple Developer signing and passkey configuration for custom builds:
# T3CODE_APPLE_TEAM_ID=ABC1234567
# T3CODE_MACOS_PROVISIONING_PROFILE=/path/to/app.provisionprofile
# T3CODE_CLERK_PASSKEY_RP_DOMAINS=auth.example.com

# For the official self-signed release workflow, configure GitHub Actions secrets
# as described in docs/operations/blackbird-releases.md, not in this file.
